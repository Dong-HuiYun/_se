{
  "name": "hotel-site",
  "version": "1.0.0",
  "description": "AI 語音分類推薦旅館網站 —— 後端 + 單元 / API / E2E 測試",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api",
    "test:e2e": "playwright test",
    "test": "jest --coverage",
    "test:all": "jest --coverage && playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 85
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
