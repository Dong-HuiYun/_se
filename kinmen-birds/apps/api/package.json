{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kinmen-birds --local --config wrangler.toml",
    "db:seed:local": "wrangler d1 execute kinmen-birds --local --file=./seed/seed.sql --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply kinmen-birds --remote --config wrangler.toml",
    "db:seed:remote": "wrangler d1 execute kinmen-birds --remote --file=./seed/seed.sql --config wrangler.toml"
  },
  "dependencies": {
    "@kinmen/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}